{
  "note": "Review-first lane. A change touching any path matching one of these patterns is reviewed BEFORE it is merged; everything else is push-then-review. When unsure, treat a change as review-first: a path list cannot see every sensitive change (a small edit elsewhere can still widen access, spend or secrets exposure). Checked by scripts/review-lane.js.",
  "known_top": [".gitattributes", ".gitignore", "DECISIONS.md", "LICENSE", "LICENSE-APACHE", "NOTICE", "PROVENANCE.md", "README.md", "README.zh-TW.md", "SECURITY.md", "THIRD_PARTY.md", "bin", "config", "docs", "guards", "lib", "modules", "package.json", "presets", "scripts", "test"],
  "lanes": [
    { "pattern": "^bin/harness\\.js$", "why": "engine profile and guardArgs" },
    { "pattern": "^bin/approve-mcp\\.js$", "why": "approve MCP" },
    { "pattern": "^bin/taskmote-mcp\\.js$", "why": "MCP tools reachable by a session, owner-question routing (ask_owner)" },
    { "pattern": "^bin/effect\\.js$", "why": "effect verification of tool calls" },
    { "pattern": "^guards/", "why": "guard hook" },
    { "pattern": "^modules/guard-base/", "why": "hard-block rules and red lines" },
    { "pattern": "^modules/guard-private-rules/", "why": "private-rule blocks" },
    { "pattern": "^modules/gitleaks/", "why": "secret scanning" },
    { "pattern": "^modules/device-pairing/", "why": "pairing, auth and tokens" },
    { "pattern": "^modules/chat-endpoint/(endpoint|index|screen)\\.js$", "why": "authenticates chat requests" },
    { "pattern": "^modules/voice-chat/(api|index)\\.js$", "why": "authenticates voice requests" },
    { "pattern": "^modules/notifications/store\\.js$", "why": "notification credentials" },
    { "pattern": "^modules/worker/(index|setup|worker|exec|policy)\\.js$", "why": "worker auth, setup and tool policy" },
    { "pattern": "^modules/tripwires/", "why": "tripwire rules and credentials" },
    { "pattern": "^modules/app-ui/web/src/taskmote/token\\.ts$", "why": "client-side owner token handling" },
    { "pattern": "^lib/redact\\.js$", "why": "secret redaction" },
    { "pattern": "^lib/config\\.js$", "why": "config, module tiers (what cannot be turned off)" },
    { "pattern": "(^|/)\\.env($|\\.)", "why": "env file" },
    { "pattern": "(^|/)(secrets?|credentials?)(\\.|/|$)", "why": "secrets file or folder" },
    { "pattern": "^test/public-boundary\\.js$", "why": "public boundary check" },
    { "pattern": "^test/(run-all|gate-lock|trunk-diff)\\.js$", "why": "gate scripts" },
    { "pattern": "^modules/roles/engines/", "why": "engine invocation" },
    { "pattern": "^lib/engines\\.js$", "why": "engine selection and invocation" },
    { "pattern": "^modules/roles/index\\.js$", "why": "daily turn cap, paid model list, allowed providers" },
    { "pattern": "^modules/spend-count/", "why": "spend counting" },
    { "pattern": "^modules/roles/(ask|groups)\\.js$", "why": "which tools and owner questions a role can reach" },
    { "pattern": "^modules/question-cards/", "why": "owner-question routing" },
    { "pattern": "^lib/modules\\.js$", "why": "grants modules power: peers, routes, public-get, raw routes" },
    { "pattern": "^lib/server\\.js$", "why": "HTTP server and request auth" },
    { "pattern": "^lib/journal\\.js$", "why": "state and journal format" },
    { "pattern": "^docs/review-lanes\\.json$", "why": "the lane file itself" },
    { "pattern": "^scripts/review-lane\\.js$", "why": "the lane script itself" },
    { "pattern": "^test/review-lane\\.js$", "why": "the lane test" }
  ]
}
